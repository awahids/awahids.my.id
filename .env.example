# Server-side SumoPod/OpenAI-compatible configuration
SUMOPOD_API_KEY=your_sumopod_api_key
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
# Accepts a single model, a JSON array, or comma-separated models.
# Each request randomly picks one model from this list.
SUMOPOD_MODEL=["gpt-4o-mini","gpt-4.1-mini"]
SUMOPOD_TIMEOUT_MS=12000
# Optional: allow backend AI endpoints to override model/base URL from Supabase cms_items.
# API key remains server-side in SUMOPOD_API_KEY and must not be stored in CMS payload.
CMS_AI_SETTINGS_ENABLED=true

# Hermes AI Assistant Configuration
HERMES_WEBHOOK_ENABLED=true
HERMES_WEBHOOK_URL=https://your-n8n-instance/webhook/hermes-assistant
HERMES_TIMEOUT_MS=30000
AI_ASSISTANT_ALLOW_SUMOPOD_FALLBACK=false

# Optional: API rate limits (per-IP, per endpoint)
AI_FAQ_RATE_WINDOW_MS=60000
AI_FAQ_RATE_MAX=20
AI_BRIEF_RATE_WINDOW_MS=60000
AI_BRIEF_RATE_MAX=10
AI_ASSISTANT_RATE_WINDOW_MS=60000
AI_ASSISTANT_RATE_MAX=10

# Optional: n8n relay from backend endpoints (recommended)
N8N_WEBHOOK_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_MS=1500
N8N_WEBHOOK_AUTH_HEADER=x-api-key
N8N_WEBHOOK_AUTH_TOKEN=

# Optional: override frontend endpoints
# Default already points to /api/ai-brief and /api/ai-faq
VITE_AI_BRIEF_ENDPOINT=/api/ai-brief
VITE_AI_FAQ_ENDPOINT=/api/ai-faq
VITE_AI_ASSISTANT_ENDPOINT=/api/ai-assistant

# Supabase CMS Configuration
# Use anon key only in Vite. Never expose the Supabase service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
