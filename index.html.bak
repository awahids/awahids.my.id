</section>

<!-- CONTACT -->
<section class="s-contact" id="contact">
  <div class="contact-inner reveal">
    <div class="contact-top">
      <h2 class="contact-headline">Got a <em>project?</em><br>Let's build it<span>.</span></h2>
      <div class="contact-badge">
        <span class="contact-badge-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h6"/></svg>
        </span>
        <div class="contact-badge-text">
          <span class="contact-badge-name">Curriculum Vitae</span>
          <span class="contact-badge-role">PDF Resume</span>
        </div>
        <a href="assets/cv/my-cv.pdf" target="_blank" rel="noopener noreferrer" class="contact-badge-link">Open CV ↗</a>
      </div>
    </div>
    <div class="contact-grid">
      <div class="contact-card reveal">
        <div class="cc-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </div>
        <span class="cc-lbl">EMAIL</span>
        <a href="mailto:awahid.safhadi@gmail.com" class="cc-val">awahid.safhadi@gmail.com</a>
        <div class="cc-remote"><div class="status-pulse"></div>AVAILABLE FOR FREELANCE</div>
      </div>
      <div class="contact-card reveal rd1">
        <div class="cc-icon">
          <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l2.12-2.12a5 5 0 0 0-7.07-7.07L11.4 5.53"/><path d="M14 11a5 5 0 0 0-7.54-.54L4.34 12.6a5 5 0 0 0 7.07 7.07l1.18-1.18"/></svg>
        </div>
        <span class="cc-lbl">SOCIALS</span>
        <div class="cc-soc-list">
          <a href="https://github.com/awahids" target="_blank" rel="noopener noreferrer" class="cc-soc-link"><strong>GITHUB</strong><span>@awahids ↗</span></a>
          <a href="https://linkedin.com/in/awahid" target="_blank" rel="noopener noreferrer" class="cc-soc-link"><strong>LINKEDIN</strong><span>/in/awahid ↗</span></a>
          <a href="https://blog.awahids.my.id" target="_blank" rel="noopener noreferrer" class="cc-soc-link"><strong>BLOG</strong><span>awahids.my.id ↗</span></a>
        </div>
      </div>
      <div class="contact-card reveal rd2">
        <div class="cc-icon">
          <svg viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <span class="cc-lbl">LOCATION</span>
        <div class="cc-loc">Cikarang, Bekasi,<br>Jawa Barat</div>
        <div class="cc-remote"><div class="status-pulse"></div>OPEN TO REMOTE</div>
      </div>
      <form id="contact-form" class="contact-form reveal rd3" novalidate data-endpoint="" data-fallback-email="awahid.safhadi@gmail.com">
        <div class="contact-form-head">
          <h3 class="cf-title">Send a Message</h3>
          <p class="cf-desc">Direct submit endpoint + mail fallback</p>
        </div>
        <div class="contact-form-grid">
          <label class="cf-field">
            <span>Full Name</span>
            <input type="text" name="name" placeholder="Your full name" autocomplete="name" required>
          </label>
          <label class="cf-field">
            <span>Email Address</span>
            <input type="email" name="email" placeholder="name@company.com" autocomplete="email" inputmode="email" required>
          </label>
          <label class="cf-field full">
            <span>Subject</span>
            <input type="text" name="subject" placeholder="Project inquiry" autocomplete="off">
          </label>
          <label class="cf-field full">
            <span>Message</span>
            <textarea name="message" placeholder="Tell me about your project and timeline..." autocomplete="off" required></textarea>
          </label>
          <input class="cf-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true">
        </div>
        <div class="cf-actions">
          <button type="submit" class="cf-submit">Send Message ↗</button>
          <p id="cf-status" class="cf-status" aria-live="polite" aria-atomic="true">Required fields: name, email, message</p>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="fc">© <span id="footer-year">2026</span> A Wahid Safhadi · Built with <b><svg viewBox="0 0 24 24" width="10" height="10" fill="var(--lime)" stroke="none" style="vertical-align:middle"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></b> &amp; too much coffee</div>
  <div class="fc">Cikarang, Bekasi, Jawa Barat · <b>awahids.my.id</b></div>
</footer>
<button type="button" class="floating-top-btn" id="floating-top-btn" aria-label="Back to top">↑</button>

</script>

<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
<script type="text/babel">
(() => {
  const templateEl = document.getElementById('app-html-template');
  const mountEl = document.getElementById('root');
  if (!templateEl || !mountEl || !window.React || !window.ReactDOM) return;

  const App = () => (
    <div dangerouslySetInnerHTML={{ __html: templateEl.innerHTML }} />
  );

  if (typeof window.ReactDOM.flushSync === 'function') {
    window.ReactDOM.flushSync(() => {
      window.ReactDOM.createRoot(mountEl).render(<App />);
    });
    return;
  }

  window.ReactDOM.createRoot(mountEl).render(<App />);
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollTrigger.min.js"></script>
<script>
  // Footer year
  const footerYearEl = document.getElementById('footer-year');
  if (footerYearEl) footerYearEl.textContent = String(new Date().getFullYear());

  // Cursor
  const cur = document.getElementById('cursor');
  const ring = document.getElementById('cursor-ring');
  const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (cur && ring && hasFinePointer) {
    let mx = 0;
    let my = 0;
    let rx = 0;
    let ry = 0;
    document.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    }, { passive: true });
    (function loop() {
      cur.style.left = `${mx}px`;
      cur.style.top = `${my}px`;
      rx += (mx - rx) * 0.11;
      ry += (my - ry) * 0.11;
      ring.style.left = `${rx}px`;
      ring.style.top = `${ry}px`;
      requestAnimationFrame(loop);
    })();
  } else {
    if (cur) cur.style.display = 'none';
    if (ring) ring.style.display = 'none';
  }

  // Nav scroll
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 50));

  // Live WIB Clock (UTC+7)
  function updateClock() {
    const now = new Date();
    const wib = new Date(now.getTime() + (now.getTimezoneOffset() * 60000) + (7 * 3600000));
    const h = String(wib.getHours()).padStart(2,'0');
    const m = String(wib.getMinutes()).padStart(2,'0');
    const s = String(wib.getSeconds()).padStart(2,'0');
    document.getElementById('time-display').textContent = `${h}:${m}:${s} WIB`;
  }
  setInterval(updateClock, 1000); updateClock();

  const hasGsap = Boolean(window.gsap && window.ScrollTrigger);
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const floatingTopBtn = document.getElementById('floating-top-btn');
  const floatingTopThreshold = () => Math.max(320, window.innerHeight * 0.35);
  const updateFloatingTopBtn = () => {
    if (!floatingTopBtn) return;
    const modalEl = document.getElementById('project-modal');
    const modalActive = Boolean(modalEl && modalEl.classList.contains('active'));
    const shouldShow = window.scrollY > floatingTopThreshold() && !modalActive && !document.body.classList.contains('is-preloading');
    floatingTopBtn.classList.toggle('is-visible', shouldShow);
  };
  if (floatingTopBtn) {
    floatingTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    });
    window.addEventListener('scroll', updateFloatingTopBtn, { passive: true });
    window.addEventListener('resize', updateFloatingTopBtn, { passive: true });
    window.addEventListener('load', updateFloatingTopBtn, { once: true });
    updateFloatingTopBtn();
  }
  const preloaderEl = document.getElementById('preloader');
  const preloaderPanel = document.getElementById('preloader-panel');
  const preloaderFill = document.getElementById('pl-progress-fill');
  const preloaderPercent = document.getElementById('pl-percent');
  const preloaderStatus = document.getElementById('pl-status');
  const preloadState = {
    progressDone: false,
    assetsDone: document.readyState === 'complete',
    hidden: false
  };

  const hidePreloader = () => {
    if (preloadState.hidden || !preloadState.progressDone || !preloadState.assetsDone) return;
    preloadState.hidden = true;
    const finalize = () => {
      if (preloaderEl) preloaderEl.remove();
      document.body.classList.remove('is-preloading');
      if (window.ScrollTrigger) ScrollTrigger.refresh(true);
      updateFloatingTopBtn();
    };

    if (hasGsap && !prefersReducedMotion && preloaderEl) {
      gsap.timeline({ onComplete: finalize })
        .to(preloaderPanel, { y: -10, scale: 0.98, duration: 0.24, ease: 'power2.inOut' })
        .to(preloaderEl, { autoAlpha: 0, duration: 0.42, ease: 'power2.out' }, 0.08);
      return;
    }
    finalize();
  };

  window.addEventListener('load', () => {
    preloadState.assetsDone = true;
    hidePreloader();
  }, { once: true });
  setTimeout(() => {
    preloadState.assetsDone = true;
    hidePreloader();
  }, 4500);

  if (preloaderEl) {
    if (hasGsap && !prefersReducedMotion) {
      const logs = Array.from(preloaderEl.querySelectorAll('.pl-log'));
      const meter = { value: 0 };
      const bootPhases = [
        'initializing',
        'loading assets',
        'binding animation',
        'ready'
      ];

      gsap.set(logs, { autoAlpha: 0, y: 10 });
      gsap.to(logs, {
        autoAlpha: 1,
        y: 0,
        duration: 0.42,
        stagger: 0.12,
        ease: 'power2.out'
      });
      if (preloaderFill) {
        gsap.set(preloaderFill, { scaleX: 0, transformOrigin: 'left center' });
        gsap.to(preloaderFill, { scaleX: 1, duration: 1.2, ease: 'power2.out' });
      }
      gsap.to(meter, {
        value: 100,
        duration: 1.2,
        ease: 'power2.out',
        onUpdate: () => {
          const v = Math.round(meter.value);
          if (preloaderPercent) preloaderPercent.textContent = `${v}%`;
          if (preloaderStatus) {
            const idx = Math.min(bootPhases.length - 1, Math.floor(v / 34));
            preloaderStatus.textContent = bootPhases[idx];
          }
        },
        onComplete: () => {
          preloadState.progressDone = true;
          hidePreloader();
        }
      });
    } else {
      if (preloaderFill) preloaderFill.style.transform = 'scaleX(1)';
      if (preloaderPercent) preloaderPercent.textContent = '100%';
      if (preloaderStatus) preloaderStatus.textContent = 'ready';
      preloadState.progressDone = true;
      setTimeout(hidePreloader, 180);
    }
  } else {
    document.body.classList.remove('is-preloading');
  }

  // Reveal (GSAP ScrollTrigger + section stagger)
  const revealTargets = Array.from(document.querySelectorAll('.reveal'));
  if (prefersReducedMotion) {
    revealTargets.forEach((el) => {
      el.style.transition = 'none';
      el.classList.add('in');
    });
  } else if (hasGsap) {
    gsap.registerPlugin(ScrollTrigger);
    document.body.classList.add('is-gsap-motion');

    const sections = Array.from(document.querySelectorAll('section, footer'));
    sections.forEach((section) => {
      const items = revealTargets.filter((el) => section.contains(el));
      if (!items.length) return;
      gsap.set(items, { autoAlpha: 0, y: 28 });
      gsap.to(items, {
        autoAlpha: 1,
        y: 0,
        duration: 0.82,
        ease: 'power3.out',
        stagger: 0.08,
        scrollTrigger: {
          trigger: section,
          start: 'top 82%',
          toggleActions: 'play none none none'
        }
      });
    });

    const progressBar = document.getElementById('scroll-progress-bar');
    if (progressBar) {
      gsap.set(progressBar, { scaleX: 0, transformOrigin: 'left center' });
      gsap.to(progressBar, {
        scaleX: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: document.documentElement,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.2
        }
      });
    }
  } else {
    const ro = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) e.target.classList.add('in'); }), { threshold: .12 });
    revealTargets.forEach(el => ro.observe(el));
  }

  // Scramble
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  function scramble(el, orig) {
    let i=0; const iv = setInterval(() => {
      el.textContent = orig.split('').map((c,j) => j<i ? orig[j] : c===' ' ? ' ' : CHARS[Math.floor(Math.random()*CHARS.length)]).join('');
      if(i++>=orig.length) clearInterval(iv);
    }, 28);
  }
  document.querySelectorAll('.hn-first,.hn-last,.hn-ghost').forEach(el => {
    const o=el.textContent; el.addEventListener('mouseenter', () => scramble(el,o));
  });

  // Project Modals
  const projectInfo = {
    'arafah-group':      { title:'Arafah Group',      cat:'NEXT.JS · JAVASCRIPT · VERCEL',    year:'2023', desc:'Website for driving course services in Bandung and surrounding areas, with focus on service information, pricing, and lead capture.', stack:['Next.js','CSS','JavaScript','HTML','Vercel','IDCloudHost'], live:'https://arafah-group.com', case:'#' },
    'adawms':            { title:'AdaWMS',            cat:'NESTJS · MYSQL · AWS S3',          year:'2024', desc:'Inventory and warehouse management platform to keep stock data synchronized between warehouses and online shop channels.', stack:['NestJS','MySQL','AWS S3','Postman','ExpressJS','NodeMailer','JWT','OAuth','Git'], live:'http://adawms.com/', case:'#' },
    'ngaji-app':         { title:'Belajar Ngaji',     cat:'HTML · JAVASCRIPT · JQUERY',       year:'2021', desc:'Simple website to learn the basics of Quran reading with interactive lesson flow and media support.', stack:['HTML','CSS','JavaScript','jQuery'], live:'https://belajar-ngaji.awahids.my.id/', case:'#' },
    'api-movie-reviews': { title:'API Movie Reviews', cat:'EXPRESSJS · POSTGRESQL · HEROKU',  year:'2021', desc:'Movie review API/platform project for creating and managing ratings and reviews, aligned with CV project stack.', stack:['ExpressJS','PostgreSQL','Heroku','Postman','Git','Cloudinary'], live:'https://github.com/awahids/API-panas.git', case:'#' },
    'tokokupon':         { title:'Tokokupon.id',      cat:'NEXT.JS · NESTJS · MYSQL',         year:'2024', desc:'Landing page and CMS build for Tokokupon platform with production deployment and content management workflow.', stack:['Next.js','NestJS','Ant Design','MySQL','HTML','CSS'], live:'https://tokokupon.com', case:'#' },
    'wms-rasa-group':    { title:'WMS Rasa Group',    cat:'VUE.JS · NESTJS · POSTGRESQL',     year:'2025', desc:'Fullstack warehouse management application initiated from scratch at Rasa Group with scalable backend architecture.', stack:['NestJS','Prisma ORM','Vue.js','PostgreSQL'], live:'', case:'#' },
    'qala-temu':         { title:'Qala Temu',         cat:'DOCKER · REACT · NESTJS',          year:'2025', desc:'Booking and appointment platform with a modern React frontend and scalable NestJS backend, built with relational data modeling and containerized deployment.', stack:['Docker','React','NestJS','Prisma','PostgreSQL'], live:'https://qala.digital', case:'#' }
  };
  const modal = document.getElementById('project-modal');
  const modalCard = modal ? modal.querySelector('.modal-card') : null;
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalLiveLink = document.getElementById('m-link-live');
  const modalCaseLink = document.getElementById('m-link-case');
  const canHover = window.matchMedia('(hover: hover)').matches;
  const useMotion = hasGsap && !prefersReducedMotion;
  let activeProjectCard = null;
  let lastFocusedElement = null;
  const restoreFocusAfterModal = () => {
    if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
      lastFocusedElement.focus({ preventScroll: true });
    }
    lastFocusedElement = null;
  };
  const setModalLinkState = (el, url, label) => {
    const hasUrl = typeof url === 'string' && url.trim() && url.trim() !== '#';
    if (hasUrl) {
      el.href = url;
      el.textContent = `${label} ↗`;
      el.classList.remove('is-disabled');
      el.removeAttribute('aria-disabled');
      el.removeAttribute('tabindex');
      return;
    }
    el.removeAttribute('href');
    el.textContent = `${label} · N/A`;
    el.classList.add('is-disabled');
    el.setAttribute('aria-disabled', 'true');
    el.setAttribute('tabindex', '-1');
  };
  const openModal = (sourceCard) => {
    if (!modal) return;
    lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow='hidden';
    updateFloatingTopBtn();
    if (!useMotion || !modalCard || !sourceCard) {
      requestAnimationFrame(() => {
        if (modalCloseBtn) modalCloseBtn.focus({ preventScroll: true });
      });
      return;
    }

    const cardRect = sourceCard.getBoundingClientRect();
    const modalRect = modalCard.getBoundingClientRect();
    const dx = (cardRect.left + cardRect.width / 2) - (modalRect.left + modalRect.width / 2);
    const dy = (cardRect.top + cardRect.height / 2) - (modalRect.top + modalRect.height / 2);
    const sx = Math.max(0.58, Math.min(1, cardRect.width / modalRect.width));
    const sy = Math.max(0.58, Math.min(1, cardRect.height / modalRect.height));

    gsap.killTweensOf([modal, modalCard]);
    gsap.set(modal, { autoAlpha: 0 });
    gsap.set(modalCard, { x: dx, y: dy, scaleX: sx, scaleY: sy, transformOrigin: 'center center' });
    gsap.timeline({
      onComplete: () => {
        if (modalCloseBtn) modalCloseBtn.focus({ preventScroll: true });
      }
    })
      .to(modal, { autoAlpha: 1, duration: 0.16, ease: 'power1.out' }, 0)
      .to(modalCard, { x: 0, y: 0, scaleX: 1, scaleY: 1, duration: 0.74, ease: 'elastic.out(1, 0.82)' }, 0.02);
  };

  const closeModal = () => {
    if (!modal || !modal.classList.contains('active')) return;
    const finalizeClose = () => {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow='';
      if (activeProjectCard) activeProjectCard.setAttribute('aria-expanded', 'false');
      activeProjectCard = null;
      updateFloatingTopBtn();
      restoreFocusAfterModal();
    };
    if (!useMotion || !modalCard) {
      finalizeClose();
      return;
    }
    gsap.killTweensOf([modal, modalCard]);
    gsap.timeline({
      onComplete: () => {
        finalizeClose();
        gsap.set(modal, { clearProps: 'opacity,visibility' });
        gsap.set(modalCard, { clearProps: 'transform' });
      }
    })
      .to(modalCard, { y: 18, scale: 0.94, duration: 0.24, ease: 'power2.in' }, 0)
      .to(modal, { autoAlpha: 0, duration: 0.2, ease: 'power1.in' }, 0.02);
  };

  const projectCards = Array.from(document.querySelectorAll('.port-card'));
  projectCards.forEach((card) => {
    const projectTitle = (card.querySelector('.port-name')?.textContent || '').trim();
    card.setAttribute('role', 'button');
    card.setAttribute('tabindex', '0');
    card.setAttribute('aria-haspopup', 'dialog');
    card.setAttribute('aria-controls', 'project-modal');
    card.setAttribute('aria-expanded', 'false');
    if (projectTitle) {
      card.setAttribute('aria-label', `Open project details: ${projectTitle}`);
    }
    const cardCta = card.querySelector('.port-link');
    if (cardCta) {
      cardCta.setAttribute('tabindex', '-1');
      cardCta.setAttribute('aria-hidden', 'true');
    }
  });
  if (useMotion && canHover) {
    projectCards.forEach((card) => {
      const deco = card.querySelector('.port-deco');
      const stack = card.querySelector('.port-stack');
      if (!deco) return;
      const decoX = gsap.quickTo(deco, 'x', { duration: 0.35, ease: 'power3.out' });
      const decoY = gsap.quickTo(deco, 'y', { duration: 0.35, ease: 'power3.out' });
      const decoR = gsap.quickTo(deco, 'rotation', { duration: 0.45, ease: 'power3.out' });
      const stackY = stack ? gsap.quickTo(stack, 'y', { duration: 0.35, ease: 'power3.out' }) : null;

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const px = ((e.clientX - rect.left) / rect.width) - 0.5;
        const py = ((e.clientY - rect.top) / rect.height) - 0.5;
        decoX(px * 26);
        decoY(py * 18);
        decoR(px * 8);
        if (stackY) stackY(py * -6);
      });
      card.addEventListener('mouseleave', () => {
        decoX(0); decoY(0); decoR(0);
        if (stackY) stackY(0);
      });
    });
  }

  const openProjectDetails = (card) => {
    const p = projectInfo[card.dataset.project];
    if (!p) return;
    if (activeProjectCard && activeProjectCard !== card) activeProjectCard.setAttribute('aria-expanded', 'false');
    activeProjectCard = card;
    activeProjectCard.setAttribute('aria-expanded', 'true');
    document.getElementById('m-title').textContent = p.title;
    document.getElementById('m-cat').textContent   = p.cat;
    document.getElementById('m-year').textContent  = p.year;
    document.getElementById('m-desc').textContent  = p.desc;
    document.getElementById('m-stack').innerHTML   = p.stack.map((s) => `<span class="m-ss-tag">${s}</span>`).join('');
    setModalLinkState(modalLiveLink, p.live, 'LIVE PRODUCT');
    setModalLinkState(modalCaseLink, p.case, 'CASE STUDY');
    if (useMotion) gsap.fromTo(card, { scale: 1 }, { scale: 0.985, duration: 0.1, yoyo: true, repeat: 1, ease: 'power1.inOut' });
    openModal(card);
  };

  projectCards.forEach((card) => {
    card.addEventListener('click', () => openProjectDetails(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openProjectDetails(card);
      }
    });
  });

  if (modal && modalCloseBtn) {
    modalCloseBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    const getModalFocusable = () => Array.from(
      modal.querySelectorAll('a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])')
    ).filter((el) => el.getAttribute('aria-hidden') !== 'true' && el.offsetParent !== null);
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('active')) return;
      if (e.key === 'Escape') {
        closeModal();
        return;
      }
      if (e.key !== 'Tab') return;
      const focusable = getModalFocusable();
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  // Career Journey
  const journeyData = {
    rasa: {
      title: 'Rasa Group',
      blurb: 'Senior IT Developer — fullstack systems with NestJS, Vue, and Postgres.',
      tag: 'Feb 2025 — Present · Cikarang',
      glyph: '✺'
    },
    ethis: {
      title: 'Ethis Indonesia',
      blurb: 'Backend Developer (Node.js & PHP) — onsite in West Jakarta for 3+ years.',
      tag: 'Jan 2022 — Feb 2025 · Onsite',
      glyph: '◍'
    },
    tokokupon: {
      title: 'Tokokupon.id',
      blurb: 'Fullstack freelance build — coupon marketplace, end-to-end shipping.',
      tag: 'Jul — Sep 2024 · Remote',
      glyph: '❍'
    },
    adala: {
      title: 'adala.id',
      blurb: 'Backend Developer (Node.js) — remote contract building production APIs.',
      tag: 'May 2020 — Dec 2021 · Remote',
      glyph: '✦'
    }
  };

  const journeyButtons = document.querySelectorAll('.journey-item');
  const journeyPath = document.getElementById('journey-path');
  const journeyBody = document.getElementById('journey-body');

  function renderJourney(id) {
    const d = journeyData[id];
    if (!d || !journeyPath || !journeyBody) return;

    journeyButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.id === id));
    journeyPath.textContent = `~/career/${id}.log`;
    journeyBody.innerHTML = `
      <div class="journey-glyph">${d.glyph}</div>
      <div>
        <div class="journey-role">// role</div>
        <h3 class="journey-company">${d.title}</h3>
      </div>
      <div>
        <p class="journey-quote">"${d.blurb}"</p>
        <div class="journey-tag-wrap">
          <span class="journey-tag">${d.tag}</span>
        </div>
        <div class="journey-command"><b>$</b> cat ./${id}.md<span class="journey-cursor">▌</span></div>
      </div>`;
  }

  journeyButtons.forEach(btn => {
    const id = btn.dataset.id;
    btn.addEventListener('mouseenter', () => renderJourney(id));
    btn.addEventListener('focus', () => renderJourney(id));
    btn.addEventListener('click', () => renderJourney(id));
  });

  // Contact form -> Formspree submit with mailto fallback
  const contactForm = document.getElementById('contact-form');
  const cfStatus = document.getElementById('cf-status');
  if (contactForm && cfStatus) {
    const cfSubmitBtn = contactForm.querySelector('.cf-submit');
    const cfEmailInput = contactForm.querySelector('input[name="email"]');
    const endpointMeta = document.querySelector('meta[name="contact-form-endpoint"]');
    const endpointFromMeta = (endpointMeta?.getAttribute('content') || '').trim();
    const requestTimeoutMs = 12000;
    const fallbackEmail = (contactForm.dataset.fallbackEmail || 'awahid.safhadi@gmail.com').trim();

    const setCfStatus = (message, type) => {
      cfStatus.textContent = message;
      cfStatus.classList.remove('is-info', 'is-success', 'is-error');
      if (type) cfStatus.classList.add(type);
    };

    const openMailClient = ({ name, email, subject, message }) => {
      if (!fallbackEmail) return false;
      const mailSubject = encodeURIComponent(subject || 'Project inquiry');
      const mailBody = encodeURIComponent(
        [
          `Name: ${name}`,
          `Email: ${email}`,
          '',
          message
        ].join('\n')
      );
      window.location.href = `mailto:${fallbackEmail}?subject=${mailSubject}&body=${mailBody}`;
      return true;
    };
    const resolveContactEndpoint = () => {
      const runtimeEndpoint = (window.CONTACT_FORM_ENDPOINT || '').toString().trim();
      const endpointRaw = runtimeEndpoint || endpointFromMeta || (contactForm.dataset.endpoint || '').trim();
      if (!endpointRaw || endpointRaw.includes('your-form-id')) return '';
      try {
        const parsed = new URL(endpointRaw, window.location.href);
        if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return '';
        return parsed.href;
      } catch (_err) {
        return '';
      }
    };
    const postContactPayload = async (endpoint, payload) => {
      const controller = new AbortController();
      const timeoutId = window.setTimeout(() => controller.abort(), requestTimeoutMs);
      try {
        return await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload),
          signal: controller.signal
        });
      } finally {
        window.clearTimeout(timeoutId);
      }
    };

    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(contactForm);
      const endpoint = resolveContactEndpoint();
      const hp = (fd.get('company') || '').toString().trim();
      const name = (fd.get('name') || '').toString().trim();
      const email = (fd.get('email') || '').toString().trim();
      const subject = (fd.get('subject') || '').toString().trim() || 'Project inquiry';
      const message = (fd.get('message') || '').toString().trim();

      if (hp) {
        setCfStatus('Submission blocked.', 'is-error');
        return;
      }
      if (!name || !email || !message) {
        setCfStatus('Please complete required fields first.', 'is-error');
        return;
      }
      if (cfEmailInput && !cfEmailInput.checkValidity()) {
        setCfStatus('Please enter a valid email address.', 'is-error');
        cfEmailInput.focus();
        return;
      }
      if (!endpoint) {
        const opened = openMailClient({ name, email, subject, message });
        setCfStatus(opened ? 'Endpoint not configured. Opening email app...' : 'Set your form endpoint first.', opened ? 'is-info' : 'is-error');
        return;
      }

      if (cfSubmitBtn) {
        cfSubmitBtn.disabled = true;
        cfSubmitBtn.setAttribute('aria-disabled', 'true');
      }
      contactForm.setAttribute('aria-busy', 'true');
      setCfStatus('Sending message...', 'is-info');

      try {
        const response = await postContactPayload(endpoint, {
          name,
          email,
          subject,
          message
        });

        if (!response.ok) {
          const err = await response.json().catch(() => ({}));
          throw new Error(err?.errors?.[0]?.message || 'Failed to send');
        }

        contactForm.reset();
        setCfStatus('Message sent successfully.', 'is-success');
      } catch (error) {
        const opened = openMailClient({ name, email, subject, message });
        const isTimeout = error?.name === 'AbortError';
        if (opened) {
          setCfStatus(isTimeout ? 'Request timed out. Opening email app...' : 'Direct submit failed. Opening email app...', 'is-info');
        } else {
          setCfStatus(isTimeout ? 'Request timed out. Please try again.' : (error.message || 'Failed to send message.'), 'is-error');
        }
      } finally {
        if (cfSubmitBtn) {
          cfSubmitBtn.disabled = false;
          cfSubmitBtn.removeAttribute('aria-disabled');
        }
        contactForm.removeAttribute('aria-busy');
      }
    });
  }

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const targetSelector = (a.getAttribute('href') || '').trim();
      if (!targetSelector || targetSelector === '#') return;
      const target = document.querySelector(targetSelector);
      if (!target) return;
      e.preventDefault();
      const navOffset = nav ? nav.offsetHeight + 12 : 0;
      const targetTop = targetSelector === '#home'
        ? 0
        : Math.max(0, target.getBoundingClientRect().top + window.scrollY - navOffset);
      window.scrollTo({
        top: targetTop,
        behavior: prefersReducedMotion ? 'auto' : 'smooth'
      });
    });
  });
</script>
</body>
</html>
