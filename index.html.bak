  <div class="reveal">
    <div class="s-eyebrow">Credentials</div>
    <h2 class="s-title">Certi<span class="s-outline">ficates</span></h2>
  </div>
  <div class="cert-grid">
    <div class="cert-card reveal">
      <div class="cert-icon"><svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg></div>
      <div class="cert-issuer">Glints Academy × Binar Academy</div>
      <div class="cert-name">Backend Developer</div>
      <div class="cert-card-view">View Credential ↗</div>
    </div>
    <div class="cert-card reveal rd1">
      <div class="cert-icon"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg></div>
      <div class="cert-issuer">Oracle Academy</div>
      <div class="cert-name">Pemrograman Database with SQL</div>
      <div class="cert-card-view">View Credential ↗</div>
    </div>
    <div class="cert-card reveal rd2">
      <div class="cert-icon"><svg viewBox="0 0 24 24"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"/></svg></div>
      <div class="cert-issuer">Oracle Academy</div>
      <div class="cert-name">Design Database</div>
      <div class="cert-card-view">View Credential ↗</div>
    </div>
    <div class="cert-card reveal">
      <div class="cert-icon"><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
      <div class="cert-issuer">Progate</div>
      <div class="cert-name">JavaScript Course</div>
      <div class="cert-card-view">View Credential ↗</div>
    </div>
    <div class="cert-card reveal rd1">
      <div class="cert-icon"><svg viewBox="0 0 24 24"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg></div>
      <div class="cert-issuer">Progate</div>
